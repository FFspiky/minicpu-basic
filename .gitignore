# Vivado local/generated state
.Xil/
*.jou
*.log
*.str
*.pb
*.wdb
*.wdf
*.wpc
xsim.dir/

# Vivado generated project directories
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/

# Generated implementation/synthesis artifacts
*.bit
*.dcp
*.rpt
*.rpx
*.vdi
*.vds

# Keep LCD pre-synthesized modules used by the board projects.
!lcd_module.dcp
!lcd_module_cell.dcp

# Generated final_cpu Vivado projects and reports.
final_cpu/mycpu_env/**/run_vivado/project/
final_cpu/mycpu_env/**/run_vivado/project_lcd/
final_cpu/mycpu_env/**/run_vivado/reports/

# Generated final_cpu function-test intermediates. Keep committed RAM images.
final_cpu/mycpu_env/func/obj/rom.vlog
final_cpu/mycpu_env/func/obj/test.s

# Generated IP helper outputs. The repository keeps XCI/MIF/COE inputs.
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/doc/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/hdl/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/misc/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/sim/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/simulation/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/synth/
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.v
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.vhd
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.vh
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.mif
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.xml
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.xdc
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*_stub.v
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*_stub.vhdl
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*_sim_netlist.v
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*_sim_netlist.vhdl
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*_ooc.xdc
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.veo
final_cpu/mycpu_env/**/rtl/xilinx_ip/**/*.vho

# Diagram editor backup files
.$*.bkp
*.drawio.bkp
