          <mxGeometry height="25" width="270" x="390" y="105" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;CSR 写入口&lt;/b&gt;&lt;br&gt;csr_we / waddr&lt;br&gt;wmask / wdata&lt;br&gt;masked_write(old,mask,new)" vertex="1">
          <mxGeometry height="190" width="330" x="100" y="240" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_7" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=5;" value="&lt;b&gt;CSR Register Bank&lt;/b&gt;&lt;br&gt;CRMD / PRMD / ECFG / ESTAT&lt;br&gt;ERA / BADV / EENTRY&lt;br&gt;SAVE0~3 / TID&lt;br&gt;TCFG / TVAL&lt;br&gt;兼容：TLBIDX/TLBEHI/TLBELO/ASID/PGD/DMW" vertex="1">
          <mxGeometry height="330" width="530" x="570" y="190" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_8" parent="1" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;direction=east;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=5;" value="&lt;b&gt;CSR Read MUX&lt;/b&gt;&lt;br&gt;地址选择相应 CSR&lt;br&gt;TICLR → 0&lt;br&gt;CPUID → 0&lt;br&gt;未知地址 → 0" vertex="1">
          <mxGeometry height="220" width="360" x="1270" y="220" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;CSR 输出&lt;/b&gt;&lt;br&gt;read_data[31:0]&lt;br&gt;csr_era / csr_eentry&lt;br&gt;ertn_pc=ERA&lt;br&gt;exc_entry=EENTRY（EXP16）" vertex="1">
          <mxGeometry height="220" width="380" x="1800" y="220" as="geometry" />
        </mxCell>
        <mxCell id="PXJts7bawON9hJTtXf92-1" edge="1" parent="1" source="csr_bank_10" style="edgeStyle=none;shape=connector;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;startSize=8;endArrow=classic;endSize=8;" target="csr_bank_7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;异常 / ERTN 更新&lt;/b&gt;&lt;br&gt;exc_valid：ERA←exc_pc&lt;br&gt;ESTAT.ECODE/ESUBCODE&lt;br&gt;PRMD←CRMD.PLV/IE&lt;br&gt;CRMD.PLV=0, IE=0&lt;br&gt;ADEF/ALE 等写 BADV&lt;br&gt;ertn：CRMD←PRMD" vertex="1">
          <mxGeometry height="320" width="530" x="570" y="620" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;中断检测&lt;/b&gt;&lt;br&gt;int_vec = ESTAT.IS[12:0] &amp; ECFG.LIE[12:0]&lt;br&gt;has_int = CRMD.IE &amp; |int_vec&lt;br&gt;single_core 在指令边界采样" vertex="1">
          <mxGeometry height="220" width="500" x="1800" y="620" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_12" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=5;" value="&lt;b&gt;64-bit Stable Counter&lt;/b&gt;&lt;br&gt;cpu_en 每拍 +1&lt;br&gt;stable_counter[31:0] → rdcntvl.w&lt;br&gt;stable_counter[63:32] → rdcntvh.w" vertex="1">
          <mxGeometry height="220" width="430" x="100" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_13" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=5;" value="&lt;b&gt;TCFG&lt;/b&gt;&lt;br&gt;En=bit0&lt;br&gt;Periodic=bit1&lt;br&gt;InitVal=bits31:2&lt;br&gt;写 TCFG：清 timer_fired&lt;br&gt;若 mask[0]：TVAL←{InitVal,2&#39;b00}" vertex="1">
          <mxGeometry height="260" width="450" x="700" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_14" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=5;" value="&lt;b&gt;TVAL / timer_fired&lt;/b&gt;&lt;br&gt;timer_en &amp; !timer_fired：&lt;br&gt;TVAL&gt;0 → TVAL-1&lt;br&gt;TVAL=0 → ESTAT.IS[11]=1&lt;br&gt;Periodic：重载 timer_init&lt;br&gt;One-shot：timer_fired=1" vertex="1">
          <mxGeometry height="300" width="480" x="1330" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;TICLR 命令&lt;/b&gt;&lt;br&gt;read_data 恒 0&lt;br&gt;csr_wdata[0]=1 → ESTAT.IS[11]←0&lt;br&gt;不保存 CLR 位" vertex="1">
          <mxGeometry height="220" width="420" x="1980" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;同一时钟沿更新优先关系&lt;/b&gt;&lt;br&gt;普通 timer/CSR 写先计算&lt;br&gt;随后 ERTN 更新 CRMD&lt;br&gt;最后 exc_valid 更新 ERA/ESTAT/PRMD/CRMD/BADV&lt;br&gt;异常字段对重叠位具有最终优先级" vertex="1">
          <mxGeometry height="280" width="330" x="100" y="620" as="geometry" />
        </mxCell>
        <mxCell id="csr_bank_17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;ESTAT 来源（当前 RTL）&lt;/b&gt;&lt;br&gt;IS[1:0]：CSR 软件写&lt;br&gt;IS[11]：定时器置位/TICLR 清除&lt;br&gt;当前 la32_csr 接口没有 hw_int[7:0] 端口&lt;br&gt;因此图中不添加不存在的外部硬中断线" vertex="1">
