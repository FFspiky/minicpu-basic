        <mxCell id="exp16_top_6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;gradientColor=none;spacing=6;" value="&lt;b&gt;PC / 同步取指与预取控制&lt;/b&gt;&lt;br&gt;PC DFF：reset=1BFF_FFFC&lt;br&gt;首次 fetch_addr=1C00_0000&lt;br&gt;valid / load_wait / muldiv_wait&lt;br&gt;fetch_addr：redirect 或 branch/PC+4&lt;br&gt;I-BRAM 下一拍输出 inst[31:0]" vertex="1">
